{
  "name": "rentcar-platform-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant rent-car platform API (Node + PostgreSQL/Neon)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:setup": "tsx src/setup-db.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "migrate:legacy": "tsx scripts/migrate-legacy.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}