{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_GUEST_USERNAME": "8090000000",
        "EXPO_PUBLIC_GUEST_PASSWORD": "8090000000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_GUEST_USERNAME": "8090000000",
        "EXPO_PUBLIC_GUEST_PASSWORD": "8090000000"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_GUEST_USERNAME": "8090000000",
        "EXPO_PUBLIC_GUEST_PASSWORD": "8090000000"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
