modules = ["nodejs-20", "php-8.2", "web", "python-base-3.13"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 23636
externalPort = 3001

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Mobile App (Expo Web)"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash /home/runner/workspace/start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Mobile App (Expo Web)"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/mobile && EXPO_NO_DOCTOR=1 npx expo start --web --port 3000 --no-dev 2>&1"
waitForPort = 3000

[userenv]

[userenv.shared]
EXPO_PUBLIC_GUEST_PASSWORD = "crguest2026"
EXPO_PUBLIC_GUEST_USERNAME = "casarivas.guest"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
