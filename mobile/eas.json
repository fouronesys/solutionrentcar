{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://assanpos.com/CF-SYSTEMS/api/v1"
      },
      "android": {
        "buildType": "apk",
        "config": "preview-android.yml"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://assanpos.com/CF-SYSTEMS/api/v1"
      },
      "ios": {
        "image": "latest"
      }
    }
  }
}