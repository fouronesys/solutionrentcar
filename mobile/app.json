{
  "expo": {
    "name": "Casa Rivas RentCar",
    "slug": "casa-rivas-rentcar",
    "scheme": "casarivasrentcar",
    "version": "1.4.1",
    "orientation": "portrait",
    "icon": "./assets/branding/casa-rivas-rent-car-app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.casarivas.rentcar",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Necesitamos la cámara para capturar fotos del vehículo y firmas.",
        "NSPhotoLibraryUsageDescription": "Para adjuntar fotos a las reservas y firmas.",
        "NSUserNotificationsUsageDescription": "Para enviarte avisos sobre tus reservas y pagos."
      },
      "icon": "./assets/branding/casa-rivas-rent-car-app-icon.png"
    },
    "android": {
      "package": "com.casarivas.rentcar",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/casa-rivas-rent-car-adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "NOTIFICATIONS",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withJvmArgs",
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación actual cuando pulsas «Usar mi ubicación actual» para mostrarte la sucursal de Casa Rivas más cercana y completar el lugar de recogida; por ejemplo, para sugerirte la sucursal más cercana al reservar un vehículo. No rastreamos tu ubicación en segundo plano."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#C79323"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "ndkVersion": "27.1.12297006",
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": false
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "apiBaseUrl": "https://assanpos.com/RENTCAR/CASARIVAS-RENTCAR/CF-SYSTEMS/api/v1",
      "eas": {
        "projectId": "daa36231-74e5-4567-847c-931ba33a13d8"
      }
    },
    "owner": "fouronesys"
  }
}
