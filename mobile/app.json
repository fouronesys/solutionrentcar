{
  "expo": {
    "name": "Yowell Rent-Car",
    "slug": "solutions-rent-car",
    "scheme": "solutionsrentcar",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solutionsrent.app",
      "buildNumber": "34",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Necesitamos la cámara para capturar fotos del vehículo y firmas.",
        "NSPhotoLibraryUsageDescription": "Para adjuntar fotos a las reservas y firmas.",
        "NSUserNotificationsUsageDescription": "Para enviarte avisos sobre tus reservas y pagos."
      },
      "icon": "./assets/icon-ios.png"
    },
    "android": {
      "package": "com.solutionsrent.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "NOTIFICATIONS",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ],
      "versionCode": 28
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withJvmArgs",
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#1828E8"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "ndkVersion": "27.1.12297006",
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "apiBaseUrl": "https://solutionsrentcar.do/CF-SYSTEMS/api/v1",
      "eas": {
        "projectId": "bf359c12-b13d-432d-944c-b059795b9f3b"
      }
    },
    "owner": "fouronesys"
  }
}
